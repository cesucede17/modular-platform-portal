# El recibidor de la Plataforma SGE -- plantilla. Copiar a .env EN EL
# SERVIDOR y rellenar. El fichero real nunca se commitea.

# Firma la cookie de sesion. Sin ella el contenedor NO arranca: generarla al
# vuelo invalidaria todas las sesiones en cada reinicio.
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# OJO: en el servidor estas tres URLs las deriva platform/compose.yml de
# SGE_BASE_DOMAIN, y no hace falta escribirlas. Esta plantilla es para
# levantar el recibidor SUELTO (fuera de platform/), donde no hay quien las
# derive. Si las escribes aqui, el dominio tiene que ser el mismo que el de
# SGE_BASE_DOMAIN o el login fallara al volver de Keycloak.

# El emisor, TAL CUAL lo declara Keycloak. Tiene que coincidir exactamente
# con el "issuer" del documento de descubrimiento. Este nombre resuelve
# dentro de sge_net gracias al alias de red del servicio keycloak.
SSO_ISSUER=http://auth.sge.local:8080/realms/sge

SSO_CLIENT_ID=dashboard

# Se obtiene de Keycloak (ver platform/identity/README.md). NUNCA se commitea.
SSO_CLIENT_SECRET=

# Los dos tienen que estar dados de alta en el cliente de Keycloak,
# literalmente iguales. Un caracter de diferencia y Keycloak rechaza.
SSO_REDIRECT_URI=http://sge.local:8080/sso/callback
SSO_POST_LOGOUT_URI=http://sge.local:8080/

# 0 mientras no haya TLS. A 1 pone Secure en la cookie, que no viaja por
# http: el login entraria en un bucle mudo.
HTTPS_ONLY=0

# Vida de la cookie de sesion, en segundos. 30 min por defecto: el recibidor
# congela los roles al entrar, asi que hasta que la cookie no caduca un rol
# nuevo no se ve. A 28800 se recuperan las 8 h de antes. No echa a nadie de
# una herramienta: cada una emite su propia cookie de 8 h (JWT_EXPIRE_HOURS).
SESSION_MAX_AGE=1800
